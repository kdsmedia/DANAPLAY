# ===== Server =====
PORT=12000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (mobile + admin)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ===== Security =====
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-please-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ===== Money / Points config =====
# 1 Rupiah = POINTS_PER_RUPIAH points  (so 10.000 points = Rp10)
POINTS_PER_RUPIAH=1000
# Withdrawal denominations in Rupiah (comma separated, fixed)
WITHDRAWAL_DENOMINATIONS=200,500,1000,2000,5000,10000
# Minimum password length
PASSWORD_MIN_LENGTH=8

# ===== Attribution provider =====
# provider: mock | adjust | appsflyer
ATTRIBUTION_PROVIDER=mock
# Shared secret used to sign/verify partner postbacks (HMAC). REQUIRED in production.
ATTRIBUTION_POSTBACK_SECRET=dev-postback-secret-change-me
# Comma-separated trusted partner IPs/CIDRs (optional, extra layer)
ATTRIBUTION_TRUSTED_IPS=

# ===== Payout (DANA) provider =====
# provider: mock | dana_api
PAYOUT_PROVIDER=mock
DANA_API_BASE_URL=
DANA_API_KEY=
DANA_MERCHANT_ID=
DANA_WEBHOOK_SECRET=

# ===== Database =====
DB_PATH=./data/danaplay.db

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ===== Daily ad-watching task =====
# Users can watch up to AD_DAILY_LIMIT ads per day; each valid (non-skipped) view
# earns AD_REWARD_PER_VIEW points. Reward is granted only after the server verifies
# the ad was watched for at least AD_MIN_WATCH_SECONDS (anti-skip).
AD_DAILY_LIMIT=50
AD_REWARD_PER_VIEW=1000
AD_MIN_WATCH_SECONDS=15
AD_COOLDOWN_SECONDS=30
AD_VIEW_TTL_SECONDS=120
